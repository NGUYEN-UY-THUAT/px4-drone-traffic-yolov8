    <!-- Pedestrians standing behind the pit wall -->
    <include>
      <pose>265.63 -138.81 2.98 0 0 -0.17</pose>
      <uri>model://casual_female</uri>
      <name>casual_female_1</name>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>1</label></plugin>
    </include>
    <include>
      <pose>279.11 -150.78 2.62 0 0 1.03</pose>
